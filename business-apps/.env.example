# ---------------------------------------------------------------------------
# Business Apps MCP Server - environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# All settings are read via src/business_apps_mcp/config.py (prefix: BAMCP_).
# ---------------------------------------------------------------------------

# --- AWS / Bedrock Knowledge Base -----------------------------------------
# AWS region hosting the Bedrock Knowledge Base + OpenSearch collection.
BAMCP_AWS_REGION=us-west-2

# Business Apps Bedrock Knowledge Base ID (DEV). REQUIRED — there is no default.
# Get it from the dev Bedrock account:
#   aws bedrock-agent list-knowledge-bases --region us-west-2 \
#     --query "knowledgeBaseSummaries[?contains(name,'business-apps')]"
BAMCP_KB_ID=

# Default number of chunks to return per query (client may override, capped by MAX_RESULTS_LIMIT).
BAMCP_DEFAULT_MAX_RESULTS=5

# Hard upper bound on results a client can request.
BAMCP_MAX_RESULTS_LIMIT=25

# --- Reranking (OFF for v1) -----------------------------------------------
# When true, a second-pass rerank model reorders results for better relevance.
# Requires extra Bedrock permission on the rerank model. Leave false to start.
BAMCP_RERANKING_ENABLED=false
# Rerank model id used only when BAMCP_RERANKING_ENABLED=true.
BAMCP_RERANKING_MODEL_ID=cohere.rerank-v3-5:0

# --- HTTP server (Streamable HTTP transport) ------------------------------
# Loopback by default (not exposed on other interfaces). The Docker image passes
# --host 0.0.0.0 to uvicorn itself, so this only matters for `python -m ...server`.
BAMCP_HOST=127.0.0.1
BAMCP_PORT=8080
# Path the MCP endpoint is served on.
BAMCP_MCP_PATH=/mcp

# --- Gateway / API-key auth (authenticates the caller) --------------------
# Comma-separated list of accepted API keys. Leave empty to DISABLE auth
# (local dev only). In production the Portkey Gateway supplies/validates keys.
BAMCP_API_KEYS=
# Header the API key is read from.
BAMCP_API_KEY_HEADER=x-api-key
# Header the Gateway uses to forward the real end-user identity.
BAMCP_IDENTITY_HEADER=x-forwarded-user

# --- User auth (Cognito access token — mirrors the Amplify backend) -------
# When true, every non-public request must carry a valid Cognito ACCESS token
# in the Authorization header (`Bearer <jwt>`). The token is verified against
# the user pool's JWKS (signature, issuer, audience, expiry, token_use=access)
# and the user's groups are read from the Cognito userInfo endpoint.
BAMCP_USER_AUTH_ENABLED=false
# Cognito user pool id SUFFIX (the part after "<region>_"). DEV default.
BAMCP_COGNITO_USER_POOL_ID=
# Cognito app client id; verified as the token audience.
BAMCP_COGNITO_APP_CLIENT_ID=
# Cognito Hosted UI userInfo endpoint (source of profile + custom:groups).
# Example: https://<domain>.auth.<region>.amazoncognito.com/oauth2/userInfo
BAMCP_COGNITO_USER_INFO_URL=
# JWKS cache lifetime in seconds.
BAMCP_JWKS_TTL_SECONDS=3600
# Verify TLS on JWKS/userInfo calls. Only set false for local dev.
BAMCP_VERIFY_SSL=true
# Dev-only bypass: if the bearer token equals this value, verification is
# skipped and a synthetic "test" user is used. Leave empty to disable.
BAMCP_BYPASS_SECRET=

# --- Authorization: who may USE this MCP server ---------------------------
# Comma-separated Cognito groups (custom:groups) allowed to use the server.
# A user whose groups don't intersect this list gets 403 Forbidden.
# Empty = any authenticated user is allowed (access check off).
# Example: BAMCP_ALLOWED_GROUPS=AAD-Apr-A3561-Dev-BusinessApps-Access
BAMCP_ALLOWED_GROUPS=

# --- Knowledge Base call ---------------------------------------------------
# Seconds to wait on the Knowledge Base call (1-300). Same name ecm-mcp-server
# uses; BAMCP_REQUEST_TIMEOUT also works.
API_REQUEST_TIMEOUT=30

# Server-side scope: a JSON Bedrock retrieval filter that is ALWAYS ANDed with the
# caller's filter, so callers can narrow results but never broaden them.
# Validated at startup. Empty = whole Knowledge Base in scope. Example:
# BAMCP_SCOPE_FILTER={"equals": {"key": "category", "value": "BusinessApps"}}
BAMCP_SCOPE_FILTER=

# --- Logging ---------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR. Same name ecm-mcp-server uses;
# BAMCP_LOG_LEVEL also works.
LOG_LEVEL=INFO
# json for production (structured), console for human-readable local dev.
BAMCP_LOG_FORMAT=json
