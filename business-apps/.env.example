# Local env variables (same names as ecm-mcp-server).
MCP_HOST=127.0.0.1
MCP_PORT=5000
LOG_LEVEL=DEBUG
ENTRA_CLIENT_ID=your-entra-client-id
ENTRA_TENANT_ID=your-entra-tenant-id
ENTRA_SCOPE=api://your-entra-app-id/.default
API_ENDPOINT=https://your-api-endpoint/
API_REQUEST_TIMEOUT=30
KB_ID=your-knowledge-base-id
# Reranking is off unless RERANK=true; then RERANKING_MODEL_ARN is required.
RERANK=false
RERANKING_MODEL_ARN=arn:aws:bedrock:us-west-2::foundation-model/cohere.rerank-v3-5:0

# Local env secrets. In deployed environments these come from the secret store.
CERTIFICATE_DATA="-----BEGIN CERTIFICATE-----
your-certificate-data-here
-----END CERTIFICATE-----
-----BEGIN ENCRYPTED PRIVATE KEY-----
your-encrypted-private-key-here
-----END ENCRYPTED PRIVATE KEY-----"

CERTIFICATE_PASSWORD=your-certificate-password
